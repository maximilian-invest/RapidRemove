# ── Microsoft 365 (Graph, app-only) ───────────────────────────────
# Werte aus der Azure App-Registrierung (Entra ID → App-Registrierungen).
# WICHTIG: M365_CLIENT_SECRET ist der "Wert" des Client-Geheimnisses
# (langer Zeichensalat), NICHT die Geheimnis-ID (GUID).
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
MAIL_FROM=info@rapid-remove.com

# Optional: Standard-Antwortadresse / Empfänger für den Test
MAIL_REPLY_TO=
TEST_TO=

# Schützt den Test-Versand-Link (/send-test). Beliebiges, langes Geheimwort.
ADMIN_TOKEN=
# PORT wird von Railway automatisch gesetzt (lokal sonst 3000)

# ── später (weitere Meilensteine) ─────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SEVDESK_API_TOKEN=
# DATABASE_URL=            # Railway-Postgres
