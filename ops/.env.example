# ── Microsoft 365 (Graph, app-only) ───────────────────────────────
# Werte aus der Azure App-Registrierung (Entra ID → App-Registrierungen).
# WICHTIG: M365_CLIENT_SECRET ist der "Wert" des Client-Geheimnisses
# (langer Zeichensalat), NICHT die Geheimnis-ID (GUID).
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
MAIL_FROM=info@rapid-remove.com

# Optional: Standard-Antwortadresse / Empfänger für den Test
MAIL_REPLY_TO=
TEST_TO=

# Empfänger der internen Bestell-Benachrichtigung (Standard: helpdesk@rapid-remove.com)
NOTIFY_TO=helpdesk@rapid-remove.com

# ── Handy-Push bei neuen Bestellungen (optional) ──────────────────
# ntfy.sh (kostenlos): App "ntfy" installieren, einen geheimen Topic abonnieren
# und denselben Namen hier eintragen. NTFY_SERVER/NTFY_TOKEN nur bei eigenem Server.
NTFY_TOPIC=
NTFY_SERVER=
NTFY_TOKEN=
# Alternativ Pushover (App ~5 €):
PUSHOVER_TOKEN=
PUSHOVER_USER=

# ── Web-Push direkt in die Admin-App (öffnet beim Tap die installierte App) ──
# VAPID-Schlüsselpaar einmalig erzeugen:  npx web-push generate-vapid-keys
# Public-Key liest der Browser über /push/vapid; Private-Key NIEMALS ins Frontend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:helpdesk@rapid-remove.com

# Schützt den Test-Versand-Link (/send-test). Beliebiges, langes Geheimwort.
ADMIN_TOKEN=
# PORT wird von Railway automatisch gesetzt (lokal sonst 3000)

# ── Stripe (Auto-Flows: Rechnung, Abo aktiviert/deaktiviert) ──────
# STRIPE_SECRET_KEY  = der "Geheim­schlüssel" aus Stripe → Entwickler → API-Schlüssel
#                      (beginnt mit sk_live_… bzw. sk_test_…, NICHT pk_/mk_).
# STRIPE_WEBHOOK_SECRET = whsec_… ; bekommt man beim Anlegen des Endpoints
#   Stripe → Entwickler → Webhooks → Endpoint: https://<railway-url>/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── ClickSend SMS (Admin-Panel: SMS an Kunden) ───────────────────
# Auth = Basic base64(username:api_key). Beides aus dem ClickSend-Dashboard
# (Account → API Credentials). NIEMALS im Code/Repo hinterlegen.
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
# Optional: Absender-ID/Nummer (sonst ClickSend-Standard)
CLICKSEND_FROM=

# ── FirstPromoter (Affiliate: Bestellung automatisch dem Partner gutschreiben) ──
# Account-API-Key aus dem FirstPromoter-Dashboard:
#   Settings → Integrations → Manage API Keys.
# NICHT der öffentliche „cid" aus dem Frontend (fpr.js) – das ist ein anderer Wert!
# NIEMALS im Code/Repo hinterlegen. Ohne diesen Key bleibt das Affiliate-Tracking aus.
FPR_API_KEY=

# ── später (weitere Meilensteine) ─────────────────────────────────
# SEVDESK_API_TOKEN=
# DATABASE_URL=            # Railway-Postgres
