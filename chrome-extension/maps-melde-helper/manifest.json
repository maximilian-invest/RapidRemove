{
  "manifest_version": 3,
  "name": "RapidRemove Maps Melde-Helper",
  "version": "1.2.2",
  "description": "Automatisiert die Google Maps Operating-Status-Meldungen für den RapidRemove Admin-Workflow.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.google.de/*",
    "https://www.google.at/*",
    "https://www.google.ch/*",
    "https://www.google.co.uk/*",
    "https://www.google.fr/*",
    "https://www.google.it/*",
    "https://www.google.es/*",
    "https://www.google.nl/*",
    "https://www.google.be/*",
    "https://www.google.pl/*",
    "https://www.google.se/*",
    "https://www.google.no/*",
    "https://www.google.dk/*",
    "https://www.google.fi/*",
    "https://www.google.pt/*",
    "https://www.google.cz/*",
    "https://www.google.hu/*",
    "https://www.google.ro/*",
    "https://www.google.gr/*",
    "https://www.google.ie/*",
    "https://www.google.lu/*",
    "https://www.google.sk/*",
    "https://www.google.si/*",
    "https://www.google.hr/*",
    "https://www.google.bg/*",
    "https://www.google.ee/*",
    "https://www.google.lv/*",
    "https://www.google.lt/*",
    "https://www.google.com.au/*",
    "https://www.google.co.nz/*",
    "https://www.google.ca/*",
    "https://www.google.co.in/*",
    "https://www.google.co.jp/*",
    "https://www.google.com.br/*",
    "https://www.google.com.mx/*",
    "https://www.google.ru/*",
    "https://maps.google.com/*",
    "https://maps.google.de/*",
    "https://maps.google.at/*",
    "https://maps.google.ch/*",
    "https://maps.google.co.uk/*",
    "https://*.google.com/*",
    "https://*.google.de/*",
    "https://*.google.at/*",
    "https://*.google.ch/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.*/maps/*",
        "https://www.google.*/*",
        "https://maps.google.*/*",
        "https://www.google.com/*",
        "https://www.google.de/*",
        "https://www.google.at/*",
        "https://www.google.ch/*",
        "https://www.google.co.uk/*",
        "https://www.google.fr/*",
        "https://www.google.it/*",
        "https://www.google.es/*",
        "https://www.google.nl/*",
        "https://maps.google.com/*",
        "https://maps.google.de/*",
        "https://maps.google.at/*"
      ],
      "js": ["selectors.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["selectors.js", "content.js", "styles.css"],
      "matches": ["https://*.google.com/*", "https://*.google.de/*", "https://*.google.at/*", "https://*.google.ch/*", "https://*.google.co.uk/*", "https://*.google.fr/*", "https://*.google.it/*", "https://*.google.es/*"]
    }
  ]
}
