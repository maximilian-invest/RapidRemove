{
  "manifest_version": 3,
  "name": "RapidRemove Maps Melde-Helper",
  "version": "1.0.0",
  "description": "Automatisiert die Google Maps 'Existiert nicht'-Meldung für den RapidRemove Admin-Workflow.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://www.google.de/maps/*",
    "https://maps.google.com/*",
    "https://maps.google.de/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://www.google.de/maps/*",
        "https://maps.google.com/*",
        "https://maps.google.de/*"
      ],
      "js": ["selectors.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
